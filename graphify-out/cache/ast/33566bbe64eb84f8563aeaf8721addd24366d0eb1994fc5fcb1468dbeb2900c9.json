 : \"default\",\r\n                display: \"inline-flex\",\r\n                alignItems: \"center\",\r\n                gap: \"4px\",\r\n              }}\r\n              title={canEdit ? \"Hacer clic para editar categor\u00eda\" : undefined}\r\n            >\r\n              {meta.icon} {meta.label}\r\n              {canEdit && isHoveredCategory && (\r\n                <span className=\"pencil-icon\" style={{ marginLeft: \"4px\", fontSize: \"10px\", opacity: 0.8 }}>\u270f\ufe0f</span>\r\n              )}\r\n            </span>\r\n          );\r\n        })", "is_member_call": false, "source_file": "C:\\Users\\ianache\\Desktop\\DATA\\01-DOCUMENTOS\\02-PROYECTOS\\112-skillvault\\src\\components\\SkillCard.tsx", "source_location": "L142"}, {"caller_nid": "components_skillcard_skillcard", "callee": "map", "is_member_call": true, "source_file": "C:\\Users\\ianache\\Desktop\\DATA\\01-DOCUMENTOS\\02-PROYECTOS\\112-skillvault\\src\\components\\SkillCard.tsx", "source_location": "L270"}, {"caller_nid": "components_skillcard_skillcard", "callee": "slice", "is_member_call": true, "source_file": "C:\\Users\\ianache\\Desktop\\DATA\\01-DOCUMENTOS\\02-PROYECTOS\\112-skillvault\\src\\components\\SkillCard.tsx", "source_location": "L270"}]}